#!/bin/sh
set -eu

APPDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export APPDIR
export PATH="$APPDIR/usr/bin:$PATH"
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
# Do not load host GIO modules against the bundled GLib: distro versions can
# be newer and fail with undefined symbols. Rufox needs no external GIO module.
export GIO_MODULE_DIR="$APPDIR/usr/lib/gio/modules"
export RUFOX_HELPER="$APPDIR/usr/libexec/rufox-helper"
export GTK_EXE_PREFIX="$APPDIR/usr"
export GTK_DATA_PREFIX="$APPDIR/usr"
export GTK_PATH="$APPDIR/usr/lib/gtk-4.0"

# linuxdeploy's GTK plugin supplies the pixbuf/typelib paths and theme hook.
for hook in "$APPDIR"/apprun-hooks/*.sh; do
  [ ! -f "$hook" ] || . "$hook"
done

if [ "${1:-}" = "--cli" ]; then
  shift
  exec "$APPDIR/usr/bin/rufox" "$@"
fi

case "${1:-}" in
  list|info|plan|write|zero|hash|badblocks)
    exec "$APPDIR/usr/bin/rufox" "$@"
    ;;
esac

exec "$APPDIR/usr/bin/rufox-gui" "$@"
